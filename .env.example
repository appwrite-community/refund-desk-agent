# Appwrite project (Console > Overview > Integrations > API keys)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=<API_KEY>

# Read by `pnpm provision` and stored as function variables
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional agent settings (defaults shown)
# AUTO_REFUND_LIMIT_CENTS=5000
# REFUND_WINDOW_DAYS=30
# RETURN_CHECK_DELAY_MINUTES=10080
